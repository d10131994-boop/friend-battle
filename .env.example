# Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (never use service_role in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Telegram bot username used in room invite links (without @)
VITE_TELEGRAM_BOT_USERNAME=yourpartygame_bot

# Telegram Mini App short name configured in BotFather
VITE_TELEGRAM_APP_SHORT_NAME=FriendBattle
